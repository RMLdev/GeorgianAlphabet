<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and transfer rules for Android 12 (API 31) and higher. For API 30 and lower see backup_rules.xml.

   Encrypted DataStore files and their Tink keysets are excluded from both cloud backup and
   device transfer: the master key lives in AndroidKeyStore and is never transferred.
   Paths are defined in core/datastore/impl/.../DataStoreFiles.kt.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="core_datastore_keysets.xml" />
        <exclude domain="file" path="datastore/encrypted/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="core_datastore_keysets.xml" />
        <exclude domain="file" path="datastore/encrypted/" />
    </device-transfer>
</data-extraction-rules>
